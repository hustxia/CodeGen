# 本机环境覆盖模板：复制为 application-local.yml 后按本机路径修改。
# application-local.yml 已在 .gitignore 中排除。
#
# 启用方式（任选其一）：
#   java -jar codegen-server.jar --spring.profiles.active=local
#   或启动时加 -Dspring.profiles.active=local
gen:
  output:
    # 目标工程根目录：生成物会写到这里
    backend-root: /path/to/your-target-project
    frontend-root: /path/to/your-target-project
  selfcheck:
    # 自检内存编译用的依赖 classpath，指向目标工程导出的依赖目录
    #   cd your-target/demo-server && mvn dependency:copy-dependencies -DoutputDirectory=../demo-lib
    classpath: /path/to/your-target-project/demo-lib/*
