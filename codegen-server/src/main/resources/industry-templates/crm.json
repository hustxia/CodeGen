{
  "key": "crm",
  "name": "客户关系 CRM",
  "desc": "客户、跟进、商机、合同、客服工单等客户运营核心域",
  "modules": [
    {
      "name": "客户管理",
      "tables": [
        {
          "tableName": "crm_customer",
          "tableComment": "客户",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "customer_name", "type": "varchar(128)", "comment": "客户名称"},
            {"name": "customer_level", "type": "tinyint", "comment": "客户等级"},
            {"name": "industry_type", "type": "tinyint", "comment": "所属行业"},
            {"name": "owner_id", "type": "bigint", "comment": "负责人"},
            {"name": "source_channel", "type": "tinyint", "comment": "来源渠道"},
            {"name": "remark", "type": "text", "comment": "客户备注"}
          ]
        },
        {
          "tableName": "crm_contact",
          "tableComment": "客户联系人",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "customer_id", "type": "bigint", "comment": "所属客户"},
            {"name": "contact_name", "type": "varchar(64)", "comment": "姓名"},
            {"name": "position", "type": "varchar(64)", "comment": "职位"},
            {"name": "contact_phone", "type": "varchar(20)", "comment": "手机号"},
            {"name": "email", "type": "varchar(128)", "comment": "邮箱"},
            {"name": "is_main_flag", "type": "tinyint", "comment": "是否主联系人"}
          ]
        },
        {
          "tableName": "follow_up_record",
          "tableComment": "跟进记录",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "customer_id", "type": "bigint", "comment": "所属客户"},
            {"name": "contact_id", "type": "bigint", "comment": "联系人"},
            {"name": "follow_type", "type": "tinyint", "comment": "跟进方式"},
            {"name": "follow_content", "type": "text", "comment": "跟进内容"},
            {"name": "next_follow_time", "type": "datetime", "comment": "下次跟进时间"}
          ]
        }
      ]
    },
    {
      "name": "商机管理",
      "tables": [
        {
          "tableName": "opportunity",
          "tableComment": "商机",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "opportunity_name", "type": "varchar(128)", "comment": "商机名称"},
            {"name": "customer_id", "type": "bigint", "comment": "关联客户"},
            {"name": "expect_amount", "type": "decimal(12,2)", "comment": "预计金额"},
            {"name": "expect_sign_date", "type": "date", "comment": "预计签约日"},
            {"name": "win_rate", "type": "decimal(5,2)", "comment": "赢单概率"},
            {"name": "stage", "type": "tinyint", "comment": "商机阶段"},
            {"name": "owner_id", "type": "bigint", "comment": "负责人"}
          ]
        },
        {
          "tableName": "opportunity_stage_record",
          "tableComment": "商机阶段变更记录",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "opportunity_id", "type": "bigint", "comment": "所属商机"},
            {"name": "from_stage", "type": "tinyint", "comment": "原阶段"},
            {"name": "to_stage", "type": "tinyint", "comment": "新阶段"},
            {"name": "change_reason", "type": "text", "comment": "变更原因"}
          ]
        }
      ]
    },
    {
      "name": "合同管理",
      "tables": [
        {
          "tableName": "contract",
          "tableComment": "销售合同",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "contract_no", "type": "varchar(64)", "comment": "合同编号"},
            {"name": "contract_name", "type": "varchar(128)", "comment": "合同名称"},
            {"name": "customer_id", "type": "bigint", "comment": "签约客户"},
            {"name": "opportunity_id", "type": "bigint", "comment": "来源商机"},
            {"name": "contract_amount", "type": "decimal(12,2)", "comment": "合同金额"},
            {"name": "sign_date", "type": "date", "comment": "签约日期"},
            {"name": "end_date", "type": "date", "comment": "到期日期"},
            {"name": "status", "type": "tinyint", "comment": "合同状态"}
          ]
        },
        {
          "tableName": "receivable_plan",
          "tableComment": "回款计划",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "contract_id", "type": "bigint", "comment": "所属合同"},
            {"name": "plan_amount", "type": "decimal(12,2)", "comment": "计划回款额"},
            {"name": "plan_date", "type": "date", "comment": "计划回款日"},
            {"name": "actual_amount", "type": "decimal(12,2)", "comment": "实际回款额"},
            {"name": "actual_date", "type": "date", "comment": "实际回款日"},
            {"name": "status", "type": "tinyint", "comment": "回款状态"}
          ]
        }
      ]
    },
    {
      "name": "客服工单",
      "tables": [
        {
          "tableName": "service_ticket",
          "tableComment": "客服工单",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "ticket_no", "type": "varchar(64)", "comment": "工单号"},
            {"name": "customer_id", "type": "bigint", "comment": "关联客户"},
            {"name": "ticket_title", "type": "varchar(128)", "comment": "工单标题"},
            {"name": "ticket_content", "type": "text", "comment": "问题描述"},
            {"name": "priority", "type": "tinyint", "comment": "优先级"},
            {"name": "assignee_id", "type": "bigint", "comment": "处理人"},
            {"name": "finish_time", "type": "datetime", "comment": "完成时间"},
            {"name": "status", "type": "tinyint", "comment": "工单状态"}
          ]
        },
        {
          "tableName": "ticket_reply",
          "tableComment": "工单回复",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "ticket_id", "type": "bigint", "comment": "所属工单"},
            {"name": "reply_content", "type": "text", "comment": "回复内容"},
            {"name": "replier_id", "type": "bigint", "comment": "回复人"},
            {"name": "reply_time", "type": "datetime", "comment": "回复时间"}
          ]
        }
      ]
    }
  ]
}
