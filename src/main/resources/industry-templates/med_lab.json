      "tables": [
        {
          "tableName": "patient",
          "tableComment": "患者档案",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "patient_name",
              "type": "varchar(64)",
              "comment": "姓名"
            },
            {
              "name": "id_card",
              "type": "varchar(64)",
              "comment": "身份证号"
            },
            {
              "name": "gender",
              "type": "tinyint",
              "comment": "性别"
            },
            {
              "name": "birth_date",
              "type": "date",
              "comment": "出生日期"
            },
            {
              "name": "phone",
              "type": "varchar(64)",
              "comment": "联系电话"
            },
            {
              "name": "address",
              "type": "varchar(255)",
              "comment": "地址"
            },
            {
              "name": "blood_type",
              "type": "varchar(64)",
              "comment": "血型"
            },
            {
              "name": "patient_code",
              "type": "varchar(64)",
              "comment": "编码"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态（1启用 0停用）"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        }
      ]
    },
