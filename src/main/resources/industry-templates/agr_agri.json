              "type": "varchar(64)",
              "comment": "联系人"
            },
            {
              "name": "contact_phone",
              "type": "varchar(64)",
              "comment": "联系电话"
            },
            {
              "name": "bank_account",
              "type": "varchar(128)",
              "comment": "银行账号"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        }
