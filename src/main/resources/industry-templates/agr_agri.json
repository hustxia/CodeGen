          "tableComment": "农资档案",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "material_name",
              "type": "varchar(128)",
              "comment": "农资名称"
            },
            {
              "name": "material_type",
              "type": "tinyint",
              "comment": "农资类型"
            },
            {
              "name": "spec",
              "type": "varchar(64)",
              "comment": "规格"
            },
            {
              "name": "stock_num",
