{
  "key": "env_waste",
  "name": "垃圾处理",
  "category": "农业环保",
  "desc": "垃圾处理场景：垃圾分类、数据统计等核心业务域",
  "modules": [
    {
      "name": "垃圾分类",
      "tables": [
        {
          "tableName": "waste_station",
          "tableComment": "垃圾站点",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "station_name",
              "type": "varchar(64)",
              "comment": "站点名称"
            },
            {
              "name": "location",
              "type": "varchar(128)",
              "comment": "位置"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            },
            {
              "name": "station_code",
              "type": "varchar(64)",
              "comment": "站点编码"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        },
        {
          "tableName": "waste_record",
          "tableComment": "收运记录",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "station_id",
              "type": "bigint",
              "comment": "站点"
            },
            {
              "name": "waste_type",
              "type": "tinyint",
              "comment": "垃圾类型"
            },
            {
              "name": "weight",
              "type": "decimal(12,2)",
              "comment": "重量"
            },
            {
              "name": "record_time",
              "type": "datetime",
              "comment": "时间"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态（1启用 0停用）"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        }
      ]
    },
    {
      "name": "数据统计",
      "tables": [
        {
          "tableName": "report",
          "tableComment": "报表定义",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_name",
              "type": "varchar(128)",
              "comment": "报表名称"
            },
            {
              "name": "report_code",
              "type": "varchar(64)",
              "comment": "报表编码"
            },
            {
              "name": "report_type",
              "type": "tinyint",
              "comment": "报表类型"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        },
        {
          "tableName": "report_metric",
          "tableComment": "报表指标",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_id",
              "type": "bigint",
              "comment": "报表"
            },
            {
              "name": "metric_name",
              "type": "varchar(64)",
              "comment": "指标名称"
            },
            {
              "name": "metric_code",
              "type": "varchar(64)",
              "comment": "指标编码"
            },
            {
              "name": "sort",
              "type": "int",
              "comment": "排序"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态（1启用 0停用）"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        }
      ]
    }
