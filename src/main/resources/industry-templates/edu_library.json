{
  "key": "edu_library",
  "name": "图书馆",
  "category": "教育培训",
  "desc": "图书馆场景：图书管理、数据统计、数据字典等核心业务域",
  "modules": [
    {
      "name": "图书管理",
      "tables": [
        {
          "tableName": "book",
          "tableComment": "图书档案",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "book_name",
              "type": "varchar(128)",
              "comment": "书名"
            },
            {
              "name": "isbn",
              "type": "varchar(64)",
              "comment": "ISBN"
            },
            {
              "name": "author",
              "type": "varchar(64)",
              "comment": "作者"
            },
            {
              "name": "publisher",
              "type": "varchar(128)",
              "comment": "出版社"
            },
            {
              "name": "stock_num",
              "type": "int",
              "comment": "馆藏数"
            }
          ]
        },
        {
          "tableName": "book_borrow",
          "tableComment": "借阅记录",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "book_id",
              "type": "bigint",
              "comment": "图书"
            },
            {
              "name": "borrower_id",
              "type": "bigint",
              "comment": "借阅人"
            },
            {
              "name": "borrow_date",
              "type": "date",
              "comment": "借出日期"
            },
            {
              "name": "return_date",
              "type": "date",
              "comment": "归还日期"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        }
      ]
    },
    {
      "name": "数据统计",
      "tables": [
        {
          "tableName": "report",
          "tableComment": "报表定义",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_name",
              "type": "varchar(128)",
              "comment": "报表名称"
            },
            {
              "name": "report_code",
              "type": "varchar(64)",
              "comment": "报表编码"
            },
            {
              "name": "report_type",
              "type": "tinyint",
              "comment": "报表类型"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        },
        {
          "tableName": "report_metric",
          "tableComment": "报表指标",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_id",
              "type": "bigint",
              "comment": "报表"
            },
            {
              "name": "metric_name",
              "type": "varchar(64)",
              "comment": "指标名称"
            },
            {
              "name": "metric_code",
              "type": "varchar(64)",
              "comment": "指标编码"
            },
            {
              "name": "sort",
              "type": "int",
              "comment": "排序"
            }
          ]
        }
      ]
    },
    {
      "name": "数据字典",
      "tables": [
        {
          "tableName": "dict_type",
          "tableComment": "字典类型",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "dict_name",
              "type": "varchar(64)",
              "comment": "字典名称"
            },
            {
              "name": "dict_code",
              "type": "varchar(64)",
              "comment": "字典编码"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        },
        {
          "tableName": "dict_item",
          "tableComment": "字典项",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "dict_type_id",
              "type": "bigint",
              "comment": "字典类型"
            },
            {
              "name": "item_label",
              "type": "varchar(64)",
              "comment": "显示名"
            },
            {
              "name": "item_value",
              "type": "varchar(64)",
              "comment": "值"
            },
            {
              "name": "sort",
              "type": "int",
              "comment": "排序"
            }
          ]
        }
      ]
    }
  ]
}
