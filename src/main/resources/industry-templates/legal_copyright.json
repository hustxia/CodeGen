            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        },
        {
          "tableName": "publication_stock",
          "tableComment": "出版物库存",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "publication_id",
              "type": "bigint",
              "comment": "出版物"
            },
            {
              "name": "warehouse_id",
