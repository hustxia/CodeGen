              "comment": "权利人"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        },
        {
          "tableName": "ip_application",
          "tableComment": "申请记录",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "asset_id",
              "type": "bigint",
              "comment": "知识产权"
            },
            {
              "name": "apply_no",
              "type": "varchar(64)",
              "comment": "申请号"
            },
            {
              "name": "apply_date",
              "type": "date",
              "comment": "申请日期"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            },
            {
              "name": "remark",
              "type": "varchar(512)",
              "comment": "备注"
            }
          ]
        }
      ]
    },
