          "tableComment": "知识产权",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "asset_name",
              "type": "varchar(128)",
              "comment": "名称"
            },
            {
              "name": "asset_type",
