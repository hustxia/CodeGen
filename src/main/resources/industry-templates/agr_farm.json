{
  "key": "agr_farm",
  "name": "农场管理",
  "category": "农业环保",
  "desc": "农场管理场景：地块管理、农资管理、养殖管理、数据统计等核心业务域",
  "modules": [
    {
      "name": "地块管理",
      "tables": [
        {
          "tableName": "land_parcel",
          "tableComment": "地块档案",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "parcel_no",
              "type": "varchar(64)",
              "comment": "地块编号"
            },
            {
              "name": "parcel_name",
              "type": "varchar(64)",
              "comment": "地块名称"
            },
            {
              "name": "area",
              "type": "decimal(12,2)",
              "comment": "面积(亩)"
            },
            {
              "name": "owner_id",
              "type": "bigint",
              "comment": "承包人"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        },
        {
          "tableName": "crop_plan",
          "tableComment": "种植计划",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "parcel_id",
              "type": "bigint",
              "comment": "地块"
            },
            {
              "name": "crop_name",
              "type": "varchar(64)",
              "comment": "作物名称"
            },
            {
              "name": "plant_date",
              "type": "date",
              "comment": "种植日期"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        }
      ]
    },
