              "comment": "出入库类型"
            },
            {
              "name": "quantity",
              "type": "decimal(12,2)",
              "comment": "数量"
            },
            {
              "name": "flow_time",
              "type": "datetime",
              "comment": "时间"
            }
          ]
        }
      ]
