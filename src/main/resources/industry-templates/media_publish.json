            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "title",
              "type": "varchar(128)",
              "comment": "书名"
            },
            {
              "name": "isbn",
              "type": "varchar(64)",
              "comment": "ISBN"
            },
            {
              "name": "author",
