{
  "key": "cms",
  "name": "内容管理 CMS",
  "desc": "栏目、文章、标签、评论、媒体资源等内容运营核心域",
  "modules": [
    {
      "name": "栏目管理",
      "tables": [
        {
          "tableName": "channel",
          "tableComment": "内容栏目",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "parent_id", "type": "bigint", "comment": "上级栏目"},
            {"name": "channel_name", "type": "varchar(64)", "comment": "栏目名称"},
            {"name": "channel_code", "type": "varchar(64)", "comment": "栏目编码"},
            {"name": "sort", "type": "int", "comment": "排序号"},
            {"name": "visible_flag", "type": "tinyint", "comment": "是否导航可见"},
            {"name": "status", "type": "tinyint", "comment": "状态（1启用 0停用）"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        }
      ]
    },
    {
      "name": "内容管理",
      "tables": [
        {
          "tableName": "article",
          "tableComment": "文章",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "article_title", "type": "varchar(128)", "comment": "文章标题"},
            {"name": "channel_id", "type": "bigint", "comment": "所属栏目"},
            {"name": "author_id", "type": "bigint", "comment": "作者"},
            {"name": "cover_image", "type": "varchar(512)", "comment": "封面图"},
            {"name": "article_summary", "type": "text", "comment": "摘要"},
            {"name": "article_content", "type": "text", "comment": "正文（富文本）"},
            {"name": "view_num", "type": "int", "comment": "阅读量"},
            {"name": "publish_time", "type": "datetime", "comment": "发布时间"},
            {"name": "status", "type": "tinyint", "comment": "发布状态"},
            {"name": "content", "type": "text", "comment": "详细内容"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        },
        {
          "tableName": "article_tag",
          "tableComment": "文章标签关联",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "article_id", "type": "bigint", "comment": "文章"},
            {"name": "tag_id", "type": "bigint", "comment": "标签"},
            {"name": "content", "type": "text", "comment": "详细内容"},
            {"name": "status", "type": "tinyint", "comment": "状态（1启用 0停用）"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        },
        {
          "tableName": "tag",
          "tableComment": "标签",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "tag_name", "type": "varchar(64)", "comment": "标签名称"},
            {"name": "use_num", "type": "int", "comment": "引用次数"},
            {"name": "tag_code", "type": "varchar(64)", "comment": "标签编码"},
            {"name": "status", "type": "tinyint", "comment": "状态（1启用 0停用）"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        }
      ]
    },
    {
      "name": "评论管理",
      "tables": [
        {
          "tableName": "comment",
          "tableComment": "文章评论",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "article_id", "type": "bigint", "comment": "所属文章"},
            {"name": "parent_id", "type": "bigint", "comment": "父级评论"},
            {"name": "commenter_id", "type": "bigint", "comment": "评论人"},
            {"name": "comment_content", "type": "text", "comment": "评论内容"},
            {"name": "like_num", "type": "int", "comment": "点赞数"},
            {"name": "audit_status", "type": "tinyint", "comment": "审核状态"},
            {"name": "content", "type": "text", "comment": "详细内容"},
            {"name": "sort", "type": "int", "comment": "排序"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        }
      ]
    },
    {
      "name": "媒体资源",
      "tables": [
        {
          "tableName": "media_asset",
          "tableComment": "媒体资源",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "media_name", "type": "varchar(128)", "comment": "资源名称"},
            {"name": "media_url", "type": "varchar(512)", "comment": "资源地址"},
            {"name": "media_type", "type": "tinyint", "comment": "资源类型"},
            {"name": "file_size", "type": "int", "comment": "文件大小(KB)"},
            {"name": "uploader_id", "type": "bigint", "comment": "上传人"},
            {"name": "media_code", "type": "varchar(64)", "comment": "资源编码"},
            {"name": "status", "type": "tinyint", "comment": "状态（1启用 0停用）"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        }
      ]
    },
    {
      "name": "用户互动",
      "tables": [
        {
          "tableName": "favorite_record",
          "tableComment": "收藏记录",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "user_id", "type": "bigint", "comment": "用户"},
            {"name": "article_id", "type": "bigint", "comment": "文章"},
            {"name": "favorite_time", "type": "datetime", "comment": "收藏时间"},
            {"name": "status", "type": "tinyint", "comment": "状态（1启用 0停用）"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        },
        {
          "tableName": "like_record",
          "tableComment": "点赞记录",
          "columns": [
            {"name": "id", "type": "bigint", "comment": "主键", "pk": true},
            {"name": "user_id", "type": "bigint", "comment": "用户"},
            {"name": "article_id", "type": "bigint", "comment": "文章"},
            {"name": "like_time", "type": "datetime", "comment": "点赞时间"},
            {"name": "status", "type": "tinyint", "comment": "状态（1启用 0停用）"},
            {"name": "remark", "type": "varchar(512)", "comment": "备注"}
          ]
        }
      ]
    }
  ]
}
