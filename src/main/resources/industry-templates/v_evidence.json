{
  "key": "v_evidence",
  "name": "电子存证",
  "category": "垂直行业",
  "desc": "电子存证场景：文件附件、日志审计、消息通知、数据统计等核心业务域",
  "modules": [
    {
      "name": "文件附件",
      "tables": [
        {
          "tableName": "file_info",
          "tableComment": "文件资源",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "file_name",
              "type": "varchar(128)",
              "comment": "文件名"
            },
            {
              "name": "file_path",
              "type": "varchar(512)",
              "comment": "存储路径"
            },
            {
              "name": "file_size",
              "type": "bigint",
              "comment": "文件大小"
            },
            {
              "name": "file_type",
              "type": "varchar(64)",
              "comment": "文件类型"
            },
            {
              "name": "uploader_id",
              "type": "bigint",
              "comment": "上传人"
            },
            {
              "name": "upload_time",
              "type": "datetime",
              "comment": "上传时间"
            }
          ]
        }
      ]
    },
    {
      "name": "日志审计",
      "tables": [
        {
          "tableName": "audit_log",
          "tableComment": "操作审计日志",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "module",
              "type": "varchar(64)",
              "comment": "模块"
            },
            {
              "name": "operation",
              "type": "varchar(64)",
              "comment": "操作"
            },
            {
              "name": "operator_id",
              "type": "bigint",
              "comment": "操作人"
            },
            {
              "name": "biz_id",
              "type": "varchar(64)",
              "comment": "业务ID"
            },
            {
              "name": "content",
              "type": "text",
              "comment": "内容"
            },
            {
              "name": "operate_time",
              "type": "datetime",
              "comment": "操作时间"
            }
          ]
        }
      ]
    },
    {
      "name": "消息通知",
      "tables": [
        {
          "tableName": "message",
          "tableComment": "站内消息",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "title",
              "type": "varchar(128)",
              "comment": "消息标题"
            },
            {
              "name": "receiver_id",
              "type": "bigint",
              "comment": "接收人"
            },
            {
              "name": "message_type",
              "type": "tinyint",
              "comment": "消息类型"
            },
            {
              "name": "content",
              "type": "text",
              "comment": "内容"
            },
            {
              "name": "read_flag",
              "type": "tinyint",
              "comment": "是否已读"
            },
            {
              "name": "send_time",
              "type": "datetime",
              "comment": "发送时间"
            }
          ]
        }
      ]
    },
    {
      "name": "数据统计",
      "tables": [
        {
          "tableName": "report",
          "tableComment": "报表定义",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_name",
              "type": "varchar(128)",
              "comment": "报表名称"
            },
            {
              "name": "report_code",
              "type": "varchar(64)",
              "comment": "报表编码"
            },
            {
              "name": "report_type",
              "type": "tinyint",
              "comment": "报表类型"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        },
        {
          "tableName": "report_metric",
          "tableComment": "报表指标",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_id",
              "type": "bigint",
              "comment": "报表"
            },
            {
              "name": "metric_name",
              "type": "varchar(64)",
              "comment": "指标名称"
            },
            {
              "name": "metric_code",
              "type": "varchar(64)",
              "comment": "指标编码"
            },
            {
              "name": "sort",
              "type": "int",
              "comment": "排序"
            }
          ]
        }
      ]
    },
    {
      "name": "数据字典",
      "tables": [
        {
          "tableName": "dict_type",
          "tableComment": "字典类型",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "dict_name",
              "type": "varchar(64)",
              "comment": "字典名称"
            },
            {
              "name": "dict_code",
              "type": "varchar(64)",
              "comment": "字典编码"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        },
        {
          "tableName": "dict_item",
          "tableComment": "字典项",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "dict_type_id",
              "type": "bigint",
              "comment": "字典类型"
            },
            {
              "name": "item_label",
              "type": "varchar(64)",
              "comment": "显示名"
            },
            {
              "name": "item_value",
              "type": "varchar(64)",
              "comment": "值"
            },
            {
              "name": "sort",
              "type": "int",
              "comment": "排序"
            }
          ]
        }
      ]
    }
  ]
}
