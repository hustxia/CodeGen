{
  "key": "env_monitor",
  "name": "环境监测",
  "category": "农业环保",
  "desc": "环境监测场景：环境监测、数据统计等核心业务域",
  "modules": [
    {
      "name": "环境监测",
      "tables": [
        {
          "tableName": "env_monitor_point",
          "tableComment": "监测点位",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "point_name",
              "type": "varchar(64)",
              "comment": "点位名称"
            },
            {
              "name": "point_code",
              "type": "varchar(64)",
              "comment": "点位编码"
            },
            {
              "name": "location",
              "type": "varchar(128)",
              "comment": "位置"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        },
        {
          "tableName": "env_monitor_record",
          "tableComment": "监测数据",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "point_id",
              "type": "bigint",
              "comment": "监测点位"
            },
            {
              "name": "pm25",
              "type": "decimal(12,2)",
              "comment": "PM2.5"
            },
            {
              "name": "pm10",
              "type": "decimal(12,2)",
              "comment": "PM10"
            },
            {
              "name": "noise",
              "type": "decimal(12,2)",
              "comment": "噪声"
            },
            {
              "name": "record_time",
              "type": "datetime",
              "comment": "采集时间"
            }
          ]
        }
      ]
    },
    {
      "name": "数据统计",
      "tables": [
        {
          "tableName": "report",
          "tableComment": "报表定义",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_name",
              "type": "varchar(128)",
              "comment": "报表名称"
            },
            {
              "name": "report_code",
              "type": "varchar(64)",
              "comment": "报表编码"
            },
            {
              "name": "report_type",
              "type": "tinyint",
              "comment": "报表类型"
            },
            {
              "name": "status",
              "type": "tinyint",
              "comment": "状态"
            }
          ]
        },
        {
          "tableName": "report_metric",
          "tableComment": "报表指标",
          "columns": [
            {
              "name": "id",
              "type": "bigint",
              "comment": "主键",
              "pk": true
            },
            {
              "name": "report_id",
              "type": "bigint",
              "comment": "报表"
            },
            {
              "name": "metric_name",
              "type": "varchar(64)",
              "comment": "指标名称"
            },
            {
              "name": "metric_code",
              "type": "varchar(64)",
              "comment": "指标编码"
            },
            {
              "name": "sort",
              "type": "int",
              "comment": "排序"
            }
          ]
        }
      ]
    }
  ]
}
